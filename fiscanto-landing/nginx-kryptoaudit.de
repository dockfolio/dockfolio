# kryptoaudit.de - 301 redirect to fiscanto.de (SEO backup brand)

server {
    listen 80;
    listen [::]:80;
    server_name kryptoaudit.de www.kryptoaudit.de;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://fiscanto.de$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kryptoaudit.de www.kryptoaudit.de;

    ssl_certificate /etc/letsencrypt/live/kryptoaudit.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kryptoaudit.de/privkey.pem;
    include /home/deploy/nginx-configs/security-headers-no-csp.conf;

    return 301 https://fiscanto.de$request_uri;

    access_log /var/log/nginx/kryptoaudit.de.access.log;
    error_log /var/log/nginx/kryptoaudit.de.error.log;
}
